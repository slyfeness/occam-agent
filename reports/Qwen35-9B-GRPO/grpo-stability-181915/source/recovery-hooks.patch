@@ -27,0 +29,8 @@
+def wait_for_archive(receipt, timeout=1800):
+    deadline = time.monotonic() + timeout
+    while not receipt.is_file():
+        if time.monotonic() >= deadline:
+            raise TimeoutError('Timed out waiting for the verified archive receipt')
+        time.sleep(1)
+
+
