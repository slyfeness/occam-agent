diff --git a/tests/test_stability_recovery.py b/tests/test_stability_recovery.py
new file mode 100644
index 0000000..9e0dd73
--- /dev/null
+++ b/tests/test_stability_recovery.py
@@ -0,0 +1,14 @@
+import unittest
+
+from src.stability_recovery import assert_snapshot_match
+
+
+class RecoveryTests(unittest.TestCase):
+    def test_full_digest_is_required_even_when_probe_matches(self):
+        archived = {'snapshot': 'step-6.safetensors', 'fingerprint': 'same',
+                    'verified_byte_count': 10, 'file_sha256': 'a'*64}
+        assert_snapshot_match(archived, dict(archived))
+        with self.assertRaisesRegex(ValueError, 'full weight digest'):
+            assert_snapshot_match(archived, dict(archived, file_sha256='b'*64))
+        with self.assertRaisesRegex(ValueError, 'full weight digest'):
+            assert_snapshot_match(archived, dict(archived, file_sha256=None))
