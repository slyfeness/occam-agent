diff --git a/src/stability_recovery.py b/src/stability_recovery.py
new file mode 100644
index 0000000..fe7467d
--- /dev/null
+++ b/src/stability_recovery.py
@@ -0,0 +1,58 @@
+"""Validate a step-5 restore and an exact replay of the three uncheckpointed updates."""
+
+import hashlib
+from pathlib import Path
+
+from .stability import read_json
+
+
+def assert_snapshot_match(archived, replayed):
+    digest = archived.get('file_sha256')
+    if not isinstance(digest, str) or len(digest) != 64 or digest != replayed.get('file_sha256'):
+        raise ValueError('Replayed full weight digest differs from the archived snapshot')
+    for key in ('snapshot', 'fingerprint', 'verified_byte_count'):
+        if archived[key] != replayed[key]:
+            raise ValueError(f'Replayed snapshot metadata differs: {key}')
+
+
+def plan_recovery(source, plan):
+    prior = read_json(source / 'RUN_PLAN.json')
+    for key in ('pool_sha256', 'seed', 'training'):
+        if prior[key] != plan[key]:
+            raise ValueError(f'Frozen run identity differs for {key}')
+    status = read_json(source / 'STATUS.json')
+    if (status['state'], status['optimizer_steps'], status['current_step'], status['stage']) != (
+            'failed', 8, 9, 'rollout_and_api_judge'):
+        raise ValueError('Expected eight committed updates followed by a failed ninth rollout')
+    checkpoint = source / 'checkpoints' / 'step-05'
+    if read_json(checkpoint / 'COMPLETE.json') != {'step': 5, 'world_size': 4}:
+        raise ValueError('Incomplete step-5 checkpoint')
+    for rank in range(4):
+        size = (checkpoint / f'checkpoint-rank{rank}.pt').stat()
+        if not size.st_size or size.st_blocks * 512 < size.st_size:
+            raise ValueError('Missing or sparse step-5 optimizer shard')
+    rows = []
+    for step in range(1, 9):
+        folder = source / f'step-{step:02d}'
+        result = read_json(folder / 'STEP_RESULT.json')
+        train = result['train']
+        if (result['step'] != step or result['query_ids'] != plan['training'][step-1]
+                or not result['policy_synced'] or not train['optimizer_step']
+                or train['adam_state_step_max'] != step):
+            raise ValueError(f'Incomplete archived step {step}')
+        archive = read_json(source / 'policy-snapshots' / f'step-{step}.json')
+        assert_snapshot_match(archive, archive)
+        batches = sorted(folder.glob('rollout-*/TRAIN_BATCH.json'))
+        if not batches:
+            raise ValueError(f'No archived training batch at step {step}')
+        rows.append({'step': step, 'folder': folder, 'result': result, 'archive': archive, 'batch': batches[-1]})
+    return checkpoint, rows
+
+
+def batch_sha256(path):
+    with Path(path).open('rb') as handle:
+        return hashlib.file_digest(handle, 'sha256').hexdigest()
+
+
+def training_history(result):
+    return {key: result['train'][key] for key in ('grad_norm', 'entropy', 'empty_or_invalid_rate')}
